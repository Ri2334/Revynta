    "test": "vitest run"
  },
  "dependencies": {
    "@clickhouse/client": "^1.3.0",
    "@revynta/config": "workspace:*",
    "@revynta/observability": "workspace:*",
    "@revynta/shared-types": "workspace:*",
    "ioredis": "^5.4.1",
    "knex": "^3.1.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "vitest": "^2.0.5"
  }
}
