# ==============================================================================
# REVYNTA SaaS ENVIRONMENT CONFIGURATION (DEVELOPMENT ONLY DEFAULTS)
# ==============================================================================
# WARNING: Do not modify this file directly with production secrets.
# Copy this file to '.env' and override variables for target environments.

NODE_ENV=development

# API Services
INGESTION_PORT=3000
INGESTION_HOST=0.0.0.0
MERCHANT_API_PORT=3001
MERCHANT_API_HOST=0.0.0.0

# PostgreSQL Transactional Database
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=revynta_dev

# ClickHouse Analytical Columnar Database
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=dev_clickhouse_pass
CLICKHOUSE_DATABASE=revynta_analytics

# Redis State Cache & BullMQ Queue
REDIS_URI=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka / Redpanda Event Broker
KAFKA_BROKERS=localhost:9092

# Cryptographic Keys (Override in production with secure keys)
# PII_ENCRYPTION_KEY must be exactly 32 bytes (256 bits) for AES-256-GCM.
PII_ENCRYPTION_KEY=dev_key_must_be_32_bytes_long_12
JWT_SECRET=revynta_secret_jwt_key_for_development

# Meta WhatsApp Cloud API Credentials
WHATSAPP_PHONE_NUMBER_ID=mock-phone-id
WHATSAPP_ACCESS_TOKEN=mock-access-token
WHATSAPP_VERIFY_TOKEN=revynta_local_verify
